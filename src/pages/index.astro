---
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = Object.values(
	import.meta.glob<{ frontmatter: { title: string; date: string }; url: string }>("./posts/*.md", { eager: true }),
).sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
---

<BaseLayout title="記事一覧">
	<h1>記事一覧</h1>
	<p>Markdown で書いた記事を Astro でビルドし、Workers Static Assets で配信するサンプル。</p>
	<ul>
		{posts.map((post) => (
			<li>
				<a href={post.url}>{post.frontmatter.title}</a>（{post.frontmatter.date}）
			</li>
		))}
	</ul>
</BaseLayout>
